# Set each host folder path and how many backups to keep locally.
# Docker Desktop accepts Windows paths such as D:/Documents.
# Set any FOLDERn_PATH to none to skip it, then start with sender.ps1
# (PowerShell) or python3 sender-compose.py (Linux/macOS).
FOLDER1_PATH=./sample-data/folder1
FOLDER1_KEEP=3

FOLDER2_PATH=./sample-data/folder2
FOLDER2_KEEP=5

FOLDER3_PATH=none
FOLDER3_KEEP=3

# Optional per-folder schedules and upload limits (KiB/s; 0 = unlimited).
FOLDER1_INTERVAL_HOURS=12
FOLDER1_BANDWIDTH_KIB_PER_SECOND=1024
FOLDER2_INTERVAL_HOURS=24
FOLDER2_BANDWIDTH_KIB_PER_SECOND=512
FOLDER3_INTERVAL_HOURS=12
FOLDER3_BANDWIDTH_KIB_PER_SECOND=1024

# For the target server, use .env.receiver.example and config/receiver.json.
LOCAL_BACKUP_PATH=./data/local-backups
REMOTE_BACKUP_PATH=./data/remote-backups
SSH_BIND_ADDRESS=0.0.0.0
SSH_PORT=2222
