# Copy to .env.mysql and use the sender launcher with compose.sender.mysql.yml.
# Set false to keep folder and MySQL backups locally without a receiver or SSH keys.
SEND_TO_REMOTE=true

# Enable any ordinary folder by replacing none with its host directory.
FOLDER1_PATH=none
FOLDER1_KEEP=3
FOLDER2_PATH=none
FOLDER2_KEEP=5
FOLDER3_PATH=none
FOLDER3_KEEP=3
LOCAL_BACKUP_PATH=./data/local-backups

# MySQL/MariaDB on this Docker host (not localhost inside the container).
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=backup
MYSQL_PASSWORD=replace-with-your-database-password
# Comma-separated database names; empty selects all non-system databases.
MYSQL_DATABASES=

# Dump immediately, then every 720 minutes. Retain 3 completed SQL dump bundles.
MYSQL_DUMP_FREQUENCY_MINUTES=720
MYSQL_DUMP_KEEP=3
# Sender archive/upload schedule and local archive retention for folder id mysql.
MYSQL_INTERVAL_HOURS=12
MYSQL_KEEP=3
MYSQL_BANDWIDTH_KIB_PER_SECOND=1024
