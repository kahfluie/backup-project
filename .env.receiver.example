# Copy this file to .env on the receiver (target server).
# Store all received archives beneath this host directory.
# Examples: /srv/backup-storage on Linux, or D:/Backups on Docker Desktop.
REMOTE_BACKUP_PATH=./data/remote-backups

# Listen for SSH/SCP connections on this interface and host port.
# Match SSH_PORT with remote.port in the sender's config/sender.json.
SSH_BIND_ADDRESS=0.0.0.0
SSH_PORT=2222

# Retention and per-sender folder allowlists go in config/receiver.json, copied
# from config/receiver.example.json. Counts below also retain all copies accepted
# within the last 168 hours. Cleanup checks every 24 hours:
# folder1: 3 backups; folder2: 5 backups; folder3: 3 backups.
# Archives are stored in REMOTE_BACKUP_PATH/folder1, /folder2, /folder3.
# Accepted archives are outside SSH jails; inboxes use a separate named volume.
# Each sender needs its own account and key file; see README for multiple senders.
# The example backup account uses secrets/authorized_keys for its PUBLIC key.
